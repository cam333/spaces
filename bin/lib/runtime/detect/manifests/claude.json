{
  "agent": "claude",
  "version": "2026.08.21.1",
  "minEngineVersion": 1,
  "rules": [
    {
      "id": "transcript_viewer",
      "state": "unknown",
      "priority": 1000,
      "region": "bottom_non_empty_lines(3)",
      "skipStateUpdate": true,
      "contains": ["showing detailed transcript"],
      "any": [
        { "contains": ["ctrl+o", "to toggle"] },
        { "contains": ["ctrl+e", "show all"] },
        { "contains": ["ctrl+e", "collapse"] },
        { "contains": ["↑↓ scroll"] },
        { "contains": ["? for shortcuts"] }
      ]
    },
    {
      "id": "live_blocked_form",
      "state": "blocked",
      "priority": 980,
      "region": "after_last_horizontal_rule",
      "contains": ["esc to cancel"],
      "any": [
        { "contains": ["enter to confirm"] },
        {
          "contains": ["enter to select"],
          "any": [
            { "contains": ["tab/arrow keys to navigate"] },
            { "contains": ["arrow keys to navigate"] },
            { "contains": ["arrows to navigate"] },
            { "contains": ["↑/↓ to navigate"] },
            { "contains": ["↑↓ to navigate"] }
          ]
        }
      ]
    },
    {
      "id": "dynamic_workflow_prompt",
      "state": "blocked",
      "priority": 980,
      "region": "whole_visible",
      "contains": ["run a dynamic workflow?", "esc to cancel"]
    },
    {
      "id": "bash_permission_prompt",
      "state": "blocked",
      "priority": 950,
      "region": "whole_visible",
      "contains": ["do you want to proceed?"],
      "any": [
        { "contains": ["bash command"] },
        { "contains": ["bash("] },
        { "contains": ["contains expansion"] },
        { "contains": ["tab to amend"] },
        { "contains": ["ctrl+e to explain"] }
      ],
      "all": [
        {
          "any": [
            { "lineRegex": ["^\\s*❯?\\s*[Yy]es\\b"] },
            { "lineRegex": ["^\\s*1\\.\\s*[Yy]es\\b"] },
            { "lineRegex": ["^\\s*2\\.\\s*[Nn]o\\b"] }
          ]
        }
      ]
    },
    {
      "id": "generic_permission_prompt",
      "state": "blocked",
      "priority": 940,
      "region": "after_last_horizontal_rule",
      "contains": ["do you want to proceed?", "esc to cancel"],
      "all": [
        {
          "any": [
            { "lineRegex": ["^\\s*❯?\\s*1\\.\\s*[Yy]es\\b"] },
            { "lineRegex": ["^\\s*2\\.\\s*[Yy]es\\b"] },
            { "lineRegex": ["^\\s*2\\.\\s*[Nn]o\\b"] },
            { "lineRegex": ["^\\s*3\\.\\s*[Nn]o\\b"] }
          ]
        }
      ]
    },
    {
      "id": "model_picker_menu",
      "state": "unknown",
      "priority": 900,
      "region": "whole_visible",
      "skipStateUpdate": true,
      "contains": ["select model", "enter to set as default", "esc to cancel"],
      "not": [
        { "contains": ["do you want to proceed?"] },
        { "contains": ["enter to select"] }
      ]
    },
    {
      "id": "osc_title_working",
      "state": "working",
      "priority": 800,
      "region": "osc_title",
      "regex": ["^[\\u2800-\\u28FF\\u25D0-\\u25D3]\\s"]
    },
    {
      "id": "btw_overlay_working",
      "state": "working",
      "priority": 795,
      "region": "bottom_non_empty_lines(5)",
      "any": [
        { "lineRegex": ["^\\s*/btw(\\s|$)"] },
        { "lineRegex": ["[Ee]sc to close\\s*$"] }
      ]
    },
    {
      "id": "live_turn_working",
      "state": "working",
      "priority": 790,
      "region": "bottom_non_empty_lines(12)",
      "any": [
        { "lineRegex": ["^\\s*[\\u23F8\\u23F5].*esc to interrupt(\\s|·|$)"] },
        { "lineRegex": ["^\\s*[*\\u00B7\\u2722\\u2736\\u273B\\u273D]\\s+\\S.*…(\\s+\\(\\d+[smh](\\s|·)|\\s*$)"] }
      ]
    },
    {
      "id": "background_shell_working",
      "state": "working",
      "priority": 785,
      "region": "bottom_non_empty_lines(5)",
      "lineRegex": ["^\\s*[\\u23F8\\u23F5].*·\\s+[1-9]\\d*\\s+shells?\\s+(·|$)"]
    },
    {
      "id": "background_agents_working",
      "state": "working",
      "priority": 785,
      "region": "last_non_empty_above_prompt_box",
      "lineRegex": ["^\\s*[*\\u00B7\\u2722\\u2736\\u273B\\u273D]\\s+Waiting for [1-9]\\d* background agents? to finish\\s*$"]
    },
    {
      "id": "esc_to_interrupt",
      "state": "working",
      "priority": 700,
      "region": "bottom_non_empty_lines(4)",
      "contains": ["esc to interrupt"]
    },
    {
      "id": "prompt_box_idle",
      "state": "idle",
      "priority": 500,
      "region": "prompt_box_body",
      "lineRegex": ["^\\s*[\\u276F>]"],
      "not": [
        { "contains": ["enter to select"] },
        { "contains": ["esc to cancel"] },
        { "contains": ["tab/arrow keys"] },
        { "contains": ["arrow keys to navigate"] },
        { "contains": ["↑/↓ to navigate"] }
      ]
    },
    {
      "id": "legacy_no_prompt_blocker",
      "state": "blocked",
      "priority": 300,
      "region": "whole_visible",
      "any": [
        { "contains": ["do you want to"], "any": [{ "contains": ["yes"] }, { "contains": ["❯"] }] },
        { "contains": ["would you like to"], "any": [{ "contains": ["yes"] }, { "contains": ["❯"] }] },
        { "contains": ["waiting for permission"] },
        { "contains": ["do you want to allow this connection?"] },
        { "contains": ["tab to amend"] },
        { "contains": ["ctrl+e to explain"] },
        { "contains": ["review your answers"] },
        { "contains": ["skip interview and plan immediately"] }
      ],
      "not": [
        { "regex": ["(^|\\n)\\s*\\u276F\\s*(\\r?\\n|$)"] }
      ]
    },
    {
      "id": "osc_title_idle",
      "state": "idle",
      "priority": 250,
      "region": "osc_title",
      "regex": ["^\\u2733\\s"]
    },
    {
      "id": "osc_progress_cleared",
      "state": "idle",
      "priority": 200,
      "region": "osc_progress",
      "regex": ["^4;0"]
    }
  ]
}
