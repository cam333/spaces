# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production (Next.js default - not used, build/ holds electron-builder resources)
# /build
build/vc_redist.x64.exe
build/icons/

# misc
.DS_Store
*.pem
*.key
*.crt
certs/

# never publish: local databases, dumps, captures, logs, reserved device names
*.db
*.sqlite
*dump*.json
*.log
*.html
report.html
screenshot*.png
Screenshot*.png
/CON
/nul

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# electron
/dist-electron/
/electron/dist/

# agent CLI config (written dynamically by terminal server)
.claude/
.claude-flow/
.gemini/
.pi/
.spaces/
vectors.db

# local CI/CD workflows (server-specific)
.github/workflows/deploy.yml
.github/workflows/deploy-dev.yml
.github/workflows/update-tracker.yml
bin/restart.sh
# never publish: any security audit/review/plan notes
docs/**/*security-audit*.md
docs/**/*security-plan*.md
docs/**/*security-review*.md
docs/security-*.md
docker-compose.dev.yml
nginx-dev.conf
# Spaces collaboration (auto-generated)
.mcp.json
.codex/

# Superpowers brainstorm sessions
.superpowers/

# Git worktrees
.worktrees/

# Playwright MCP session dumps
.playwright-mcp/

# maintainer-internal planning notes — never published
docs/plans/
docs/superpowers/
